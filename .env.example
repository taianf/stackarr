# Copy to .env and adjust. Never commit the real .env.
#
# This file is the tracked, secret-free template: it must contain no real
# password. scripts/apply-admin-password.sh rewrites the password entries and
# the corresponding service configs, so the values below only need to be set
# once.

# --- secrets: set these, do not reuse the placeholders ---
STACKARR_ADMIN_USERNAME=admin
STACKARR_ADMIN_PASSWORD=change-me
TINYMEDIAMANAGER_PASSWORD=change-me

# --- host / docker ---
PUID=1000
PGID=1000
STACKARR_DOCKER_GID=1001
TIMEZONE=Europe/Lisbon

# --- network ---
# 127.0.0.1 keeps the whole stack off the LAN. Set to 0.0.0.0 to expose it,
# and note that every service then has no authentication in front of it.
STACKARR_BIND_IP=127.0.0.1
STACKARR_WEB_PORT=7777

# --- paths ---
# The *_ROOT values must be absolute and, in practice, point inside APP_ROOT.
APP_ROOT=/home/taian/workspace/stackarr/.stackarr
CONFIG_ROOT=/home/taian/workspace/stackarr/.stackarr/config
STATE_ROOT=/home/taian/workspace/stackarr/.stackarr/state
LOG_ROOT=/home/taian/workspace/stackarr/.stackarr/logs
MEDIA_ROOT=/home/taian/workspace/stackarr/.stackarr/media
MUSIC_ROOT=/home/taian/workspace/stackarr/.stackarr/media/Music
DOWNLOADS_ROOT=/home/taian/workspace/stackarr/.stackarr/downloads
BACKUP_ROOT=/home/taian/workspace/stackarr/.stackarr/backups
STACKARR_DATABASE_DIR=/home/taian/workspace/stackarr/.stackarr/config

# --- language ---
# Read by scripts/apply-language-config.sh, which pushes these into the
# services. The Radarr/Sonarr/Lidarr/Prowlarr UI language is NOT taken from
# STACKARR_UI_LANGUAGE: those apps store an index into their own per-app enum
# (Radarr 30, Sonarr 33, Lidarr 30, Prowlarr "pt_BR"), so it is hardcoded in
# that script and has to be read back from each web UI.
STACKARR_UI_LANGUAGE=pt-BR
STACKARR_CONTENT_LANGUAGE=pt-BR
STACKARR_SUBTITLES=pt-BR,en
# "original" keeps the source audio track; the script never prefers a dub.
STACKARR_AUDIO=original

STACKARR_TELEMETRY_ENABLED=false
