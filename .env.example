# ============================================================================
# Stackarr - template de configuracao. Copie para .env e ajuste.
#
#   cp .env.example .env
#   ./scripts/apply-admin-password.sh            # aplica as credenciais
#   ./scripts/apply-admin-password.sh --check    # so relata
#
# NUNCA faça commit do .env: ele guarda senhas em texto puro. Este arquivo e o
# unico que vai para o repo, e nao pode conter segredo real.
#
# As chaves de segredo abaixo estao VAZIAS de proposito. O docker-compose.yml
# marca cada uma com :? (obrigatoria, sem default), entao o stack recusa a
# subir enquanto alguma ficar vazia. Isso e o que impede o pior erro: um
# template com senha de exemplo preenchida sobe o stack com essa senha em
# qualquer maquina que copiar o arquivo, e ela passaria a ser um segredo
# publicado no repo. Preencha e o compose passa a validar.
# ============================================================================

# --- Sistema e permissoes Docker -------------------------------------------
PUID=1000
PGID=1000
STACKARR_DOCKER_GID=1001
TIMEZONE=Etc/UTC

# --- Rede ------------------------------------------------------------------
# SEGURANCA: 127.0.0.1 mantem o stack so na maquina. Bind em 0.0.0.0 expoe
# todos os servicos na LAN sem autenticacao - varios deles (Sonarr, Radarr,
# Prowlarr, qBittorrent, Sonarr4K) vem sem login por padrao.
STACKARR_BIND_IP=127.0.0.1
STACKARR_WEB_PORT=7777

# --- Caminhos --------------------------------------------------------------
# Absolutos e, na pratica, dentro de APP_ROOT. Ajuste APP_ROOT e derive os
# demais (o prefixo e o mesmo, o sufixo muda).
APP_ROOT=/caminho/para/stackarr/.stackarr
CONFIG_ROOT=/caminho/para/stackarr/.stackarr/config
STATE_ROOT=/caminho/para/stackarr/.stackarr/state
LOG_ROOT=/caminho/para/stackarr/.stackarr/logs
MEDIA_ROOT=/caminho/para/stackarr/.stackarr/media
MUSIC_ROOT=/caminho/para/stackarr/.stackarr/media/Music
DOWNLOADS_ROOT=/caminho/para/stackarr/.stackarr/downloads
BACKUP_ROOT=/caminho/para/stackarr/.stackarr/backups
STACKARR_DATABASE_DIR=/caminho/para/stackarr/.stackarr/config

STACKARR_TELEMETRY_ENABLED=false

# ============================================================================
# Idioma
# ----------------------------------------------------------------------------
#   ./scripts/apply-language-config.sh            # aplicar
#   ./scripts/apply-language-config.sh --check    # so relatar
#
# UI_LANGUAGE      idioma da interface
# CONTENT_LANGUAGE  idioma dos metadados/titulos no scanning
# SUBTITLES        legenda preferida, em ordem; a primeira e a principal
# AUDIO            "original" mantem o audio de origem e nunca forca dublagem
#
# O idioma de UI do Radarr/Sonarr/Lidarr/Prowlarr NAO vem deste arquivo: cada
# app guarda um indice no seu proprio enum, que difere entre apps (Radarr 30,
# Sonarr 33, Lidarr 30, Prowlarr a string "pt_BR"). Esses valores estao fixos
# em scripts/apply-language-config.sh e foram confirmados na UI de cada app.
# ============================================================================
STACKARR_UI_LANGUAGE=pt-BR
STACKARR_CONTENT_LANGUAGE=pt-BR
STACKARR_SUBTITLES=pt-BR,en
STACKARR_AUDIO=original

# ============================================================================
# SEGREDOS
# ----------------------------------------------------------------------------
# Troque TODOS os valores abaixo. O compose exige estas chaves (por isso o :?),
# entao o stack nao sobe enquanto faltarem.
#
# Todas as senhas aqui estao vazias: preencha todas antes de subir o stack.
# Use 32+ caracteres alfanumericos, por exemplo:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
#
# ATENCAO - senha unica compartilhada: STACKARR_ADMIN_PASSWORD e aplicada de
# proposito ao admin de Postgres, qBittorrent, Radarr, Sonarr, Lidarr,
# Prowlarr, Bazarr e tinyMediaManager. E um ponto unico de comprometimento: quem
# obter a senha acessa todos os servicos. Serve para uma LAN confiavel. Se for
# expor na internet, use senhas por servico em vez de reusar esta.
#
# Recyclarr nao tem login admin. Jellyfin guarda hash PBKDF2 por usuario, com
# salt proprio, que o script nao escreve - defina a senha do Jellyfin a mao.
# ============================================================================
STACKARR_ADMIN_USERNAME=admin
STACKARR_ADMIN_PASSWORD=
TINYMEDIAMANAGER_PASSWORD=

# --- Senhas de banco exigidas pelo compose ---------------------------------
# Vale para servicos ainda nao implantados tambem: o Postgres so aceita
# POSTGRES_PASSWORD no primeiro initdb do volume, entao trocar isto depois de
# o volume existir nao muda a senha do banco - e o un jeito de trocar e o
# script apply-admin-password.sh (que faz ALTER ROLE).
DATABASE_SUPERUSER_PASSWORD=
RADARR_POSTGRES_PASSWORD=
RADARR4K_POSTGRES_PASSWORD=
SONARR_POSTGRES_PASSWORD=
SONARR4K_POSTGRES_PASSWORD=
LIDARR_POSTGRES_PASSWORD=
PROWLARR_POSTGRES_PASSWORD=
BAZARR_POSTGRES_PASSWORD=

# --- Segredos de servicos ainda nao implantados ----------------------------
ROMM_DB_PASSWORD=
IMMICH_DB_PASSWORD=
SEERR_POSTGRES_PASSWORD=
ROMM_AUTH_SECRET_KEY=
BOOKORBIT_JWT_SECRET=
BOOKORBIT_SETUP_TOKEN=

# --- DSNs -------------------------------------------------------------------
# A senha fica dentro da URL, por isso o compose nao pode ter default: um DSN
# com senha no compose e um segredo publicado. A senha aqui precisa ser a
# mesma da variavel abaixo.
BOOKORBIT_DB_PASSWORD=
TRACEARR_DB_PASSWORD=
BOOKORBIT_DATABASE_URL=postgres://bookorbit:@database:5432/bookorbit
TRACEARR_DATABASE_URL=postgres://tracearr:@database:5432/tracearr

# --- Chaves opcionais ------------------------------------------------------
# Deixe vazio para nao usar. Exemplos: TDARR_API_KEY, MAINTAINERR_GITHUB_TOKEN,
# ROMM_MOBYGAMES_API_KEY, ROMM_RETROACHIEVEMENTS_API_KEY, ROMM_STEAMGRIDDB_API_KEY,
# ROMM_IGDB_CLIENT_ID, ROMM_IGDB_CLIENT_SECRET, ROMM_SCREENSCRAPER_PASSWORD,
# TRACEARR_JWT_SECRET, TRACEARR_COOKIE_SECRET, QUESTARR_JWT_SECRET,
# YOUTARR_ADMIN_PASSWORD, YOUTARR_DB_PASSWORD, YOUTARR_DB_ROOT_PASSWORD,
# CLEANUPARR_POSTGRES_PASSWORD, PULSARR_DB_PASSWORD.
